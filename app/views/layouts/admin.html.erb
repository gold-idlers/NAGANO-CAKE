<!DOCTYPE html>
<html>
  <head>
    <title>NAGANO CAKE 管理者画面</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header style="display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-bottom: 1px solid #000;">
      <div>
        <%= link_to "ロゴ入れる", admin_path %>
      </div>
      <nav>
        <%= link_to "About", about_path %>
        <%= link_to "商品一覧", admin_items_path %>
        <% if @current_admin %>
          <%= link_to "会員一覧", admin_customers_path %>
          <%= link_to "注文履歴一覧", admin_orders_path %>
          <%= link_to "ジャンル一覧", admin_genres_path %>
          <%= link_to "ログアウト", admin_session_path, data: { turbo_method: :delete } %>
        <% else %>
          <%= link_to "新規登録", customers_sign_up_path %>
          <%= link_to "ログイン", new_admin_session_path %>
        <% end %>
      </nav>
    </header>

    <main>
      <% if flash[:notice] %>
        <p><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>