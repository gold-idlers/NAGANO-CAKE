<%# 左サイドバー：ジャンル検索 %>
<div class="border p-3 me-4 ms-5" style="min-width: 150px;">
  <p class="fw-bold text-center">ジャンル検索</p>
  <% @genres.each do |genre| %>
    <p><span class="fs-10", style="color: #e6e6e6;" >▶　</span><%= link_to genre.name, items_path(genre_id: genre.id) %></p>
  <% end %>
</div>