<!DOCTYPE html>
<html>
  <head>
    <title>NAGANO CAKE</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body class="d-flex flex-column min-vh-100">
<header style="border-bottom: 1px solid #000;">
  <%# 1行目：ロゴ・ナビゲーション %>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; padding: 10px 20px 0 20px;">
    <div>
      <%= link_to root_path do %>
        <%= image_tag "nagano-cake-logo.png", height: "100" %>
      <% end %>
    </div>

    <nav>
      <div class="mt-2">
        <% if current_customer %>
          <%= link_to "マイページ", customers_my_page_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "商品一覧", items_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "カート", cart_items_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "ログアウト", session_path, data: { turbo_method: :delete }, class: "btn btn-light me-4", style: "width: 90px;" %>
        <% else %>
          <%= link_to "About", about_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "商品一覧", items_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "新規登録", customers_sign_up_path, class: "btn btn-light me-4", style: "width: 90px;" %>
          <%= link_to "ログイン", new_session_path, class: "btn btn-light me-4", style: "width: 90px;" %>
        <% end %>
      </div>

      <%# 2行目：ようこそ・検索ボックス %>
      <div class="d-flex align-items-center justify-content-end gap-3 mt-2">
        <% if current_customer %>
          <span>ようこそ、<%= current_customer.last_name %>さん！</span>
        <% end %>
        <div class="d-flex">
          <input type="text" class="form-control" placeholder="Search" style="width: 200px;">
          <button class="btn btn-outline-secondary" type="button">🔍</button>
        </div>
      </div>
    </nav>
  </div>
</header>

    <main class="flex-grow-1 mt-3 ms-5">
      <% if flash[:notice] %>
        <p><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p><%= flash[:alert] %></p>
      <% end %>

      <!-- サイドバー -->
      <div class="row px-5">
        <% if content_for?(:sidebar) %>
      <div class="col-md-2">
        <%= render 'layouts/sidebar' %>
      </div>
      <div class="col-md-10">
        <%= yield %>
      </div>
        <% else %>
      <div class="col-md-12 px-5">
        <%= yield %>
      </div>
        <% end %>
      </div>
    </main>

    <footer class="mt-2 py-4 bg-light">
    <p class="text-center fs-10 py-3 align-items-center">&copy; 2026 NAGANO CAKE All Rights Reserved.</p>
    </footer>

  </body>
</html>