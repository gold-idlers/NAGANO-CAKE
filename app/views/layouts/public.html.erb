<!DOCTYPE html>
<html>
  <head>
    <title>NAGANO CAKE</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
  <header style="display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-bottom: 1px solid #000;">
  <div>
    <%= link_to root_path, style: "text-decoration: none;" do %>
      <div style="width: 150px; height: 50px; border: 2px solid #000; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #000;">
      LOGO(顧客)
      </div>
    <% end %>
  </div>
    <nav>
      <%= link_to "About", about_path, class: "btn btn-light me-4", style: "width: 90px;" %>
      <%= link_to "商品一覧", items_path, class: "btn btn-light me-4", style: "width: 90px;" %>
      <% if current_customer %>
        <%= link_to "マイページ", customers_my_page_path, class: "btn btn-light me-4", style: "width: 90px;" %>
        <%= link_to "ログアウト", session_path, data: { turbo_method: :delete }, class: "btn btn-light me-4", style: "width: 90px;" %>
      <% else %>
        <%= link_to "新規登録", customers_sign_up_path, class: "btn btn-light me-4", style: "width: 90px;" %>
        <%= link_to "ログイン", new_session_path, class: "btn btn-light me-4", style: "width: 90px;" %>
      <% end %>
    </nav>
  </header>
    <main class="container px-5 mt-4">
      <% if flash[:notice] %>
        <p><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p><%= flash[:alert] %></p>
      <% end %>

      <!-- サイドバー -->
      <div class="row">
        <% if content_for?(:sidebar) %>
      <div class="col-md-2">
        <%= render 'layouts/sidebar' %>
      </div>
      <div class="col-md-10">
        <%= yield %>
      </div>
        <% else %>
      <div class="col-md-12">
        <%= yield %>
      </div>
        <% end %>
      </div>
    </main>
    <footer class="mt-5 py-4">
    </footer>
  </body>
</html>