<div class="d-flex">

  <%# サイドバー共通レイアウト %>
  <%= content_for :sidebar, true %>

  <%# 商品詳細 %>
  <div class="d-flex gap-4">
    <%# 商品画像 %>
    <div>
      <% if @item.image.attached? %>
        <%= image_tag @item.image, style: "width: 200px; height: 200px; object-fit: cover;" %>
      <% else %>
        <div class="bg-secondary" style="width: 200px; height: 200px;"></div>
      <% end %>
    </div>

    <%# 商品情報 %>
    <div>
      <h4><%= @item.name %></h4>
      <p><%= @item.introduction %></p>
      <p class="fs-5">¥ <%= number_with_delimiter(@item.price) %>（税込）</p>

      <%# カートに入れるフォーム（ログイン時のみ） %>
      <% if current_customer %>
        <%= form_with url: cart_items_path, method: :post, scope: :cart_item do |f| %>
          <%= f.hidden_field :item_id, value: @item.id %>
          <div class="d-flex gap-2 align-items-center">
            <%= f.select :amount, (1..10).map { |i| [i, i] },
              { include_blank: "個数選択" },
              { class: "form-select w-25" } %>
            <%= f.submit "カートに入れる", class: "btn btn-success" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>