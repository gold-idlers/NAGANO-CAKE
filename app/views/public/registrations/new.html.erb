<%# app/views/public/registrations/new.html.erb %>
<h2>新規会員登録</h2>

<%= form_with model: @customer, url: signup_path do |f| %>
  <% if @customer.errors.any? %>
    <div style="color:red">
      <% @customer.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :last_name, "名前(姓)" %>
    <%= f.text_field :last_name, placeholder: "令和" %>
    <%= f.label :first_name, "(名)" %>
    <%= f.text_field :first_name, placeholder: "道子" %>
  </div>

  <div>
    <%= f.label :last_name_kana, "フリガナ(セイ)" %>
    <%= f.text_field :last_name_kana, placeholder: "レイワ" %>
    <%= f.label :first_name_kana, "(メイ)" %>
    <%= f.text_field :first_name_kana, placeholder: "ミチコ" %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %>
    <%= f.email_field :email_address, placeholder: "sample@example.com" %>
  </div>

  <div>
    <%= f.label :postal_code, "郵便番号(ハイフンなし)" %>
    <%= f.text_field :postal_code, placeholder: "0000000" %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address, placeholder: "東京都渋谷区代々木神園町0-0" %>
  </div>

  <div>
    <%= f.label :phone_number, "電話番号(ハイフンなし)" %>
    <%= f.text_field :phone_number, placeholder: "0000000000" %>
  </div>

  <div>
    <%= f.label :password, "パスワード(6文字以上)" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "パスワード(確認用)" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "新規登録", class: "btn btn-success" %>

<% end %>

<p>既に登録済みの方</p>
<%= link_to "こちら", new_session_path %>
からログインしてください。