<div class="container">
  <span class="bg-light px-3 fs-5 fw-bold">会員情報編集</span>

  <%= form_with model: @customer, url: customers_information_path, method: :patch do |f| %>
    <div class="mb-3">
      <label class="form-label">氏名</label>
      <div class="d-flex gap-2">
        <%= f.text_field :last_name, class: "form-control", placeholder: "姓" %>
        <%= f.text_field :first_name, class: "form-control", placeholder: "名" %>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">フリガナ</label>
      <div class="d-flex gap-2">
        <%= f.text_field :last_name_kana, class: "form-control", placeholder: "セイ" %>
        <%= f.text_field :first_name_kana, class: "form-control", placeholder: "メイ" %>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">郵便番号</label>
      <%= f.text_field :postal_code, class: "form-control" %>
    </div>

    <div class="mb-3">
      <label class="form-label">住所</label>
      <%= f.text_field :address, class: "form-control" %>
    </div>

    <div class="mb-3">
      <label class="form-label">電話番号</label>
      <%= f.text_field :phone_number, class: "form-control" %>
    </div>

    <div class="mb-3">
      <label class="form-label">メールアドレス</label>
      <%= f.text_field :email_address, class: "form-control" %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "編集内容を保存", class: "btn btn-success" %>
      <%= link_to "退会する", customers_unsubscribe_path, class: "btn btn-danger" %>
    </div>
  <% end %>
</div>