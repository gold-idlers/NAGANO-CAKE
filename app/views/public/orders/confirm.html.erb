<span class="bg-light px-3 fs-5 fw-bold">注文情報確認</span>

<div class="d-flex gap-4 mt-2 mb-1">

<div class="w-75">
<table class="table table-bordered ">
  <colgroup>
    <col class="w-50">
    <col>
    <col>
    <col>
	</colgroup>
  <thead>
    <tr class="table-light">
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @cart_items.each do |cart_item| %>
      <tr>
        <td><%= cart_item.item.name %></td>
        <td><%= number_with_delimiter((cart_item.item.price * 1.1).ceil) %></td>
        <td><%= cart_item.amount %></td>
        <td><%= number_with_delimiter(((cart_item.item.price * 1.1).ceil * cart_item.amount)) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<div>
<table class="table table-bordered">
  <tr>
    <th class="table-light">送料</th>
    <td><%= @order.shopping_cost %></td>
  </tr>
  <tr>
    <th class="table-light">商品合計</th>
    <td><%= number_with_delimiter(@cart_items.sum { |c| (c.item.price * 1.1).ceil * c.amount }) %></td>
  </tr>
  <tr>
    <th class="table-light">請求金額</th>
    <td><%= @order.total_payment %></td>
  </tr>
</table>
</div>

</div>

<table class="table table-borderless">
  <colgroup>
    <col style="width: 120px;">
    <col>
  </colgroup>
  <tbody>
    <tr>
      <td class="fs-5 fw-bold">支払方法</td>
      <td><%= @order.payment_method %></td>
    </tr>
    <tr>
      <td class="fs-5 fw-bold">お届け先</td>
      <td>
        〒<%= @order.postal_code %> <%= @order.address %><br>
        <%= @order.name %>
      </td>
    </tr>
  </tbody>
</table>

<%= form_with url: orders_path, method: :post, scope: :order, data: { turbo: false } do |f| %>
  <%= f.hidden_field :postal_code, value: @order.postal_code %>
  <%= f.hidden_field :address, value: @order.address %>
  <%= f.hidden_field :name, value: @order.name %>
  <%= f.hidden_field :payment_method, value: @order.payment_method %>
  <%= f.hidden_field :shopping_cost, value: @order.shopping_cost %>
  <%= f.hidden_field :total_payment, value: @order.total_payment %>
  <div class="text-center mt-3">
    <%= f.submit "注文を確定する", class: "btn btn-success px-4" %>
  </div>
<% end %>