<h1>注文履歴詳細</h1>

<h2>注文情報</h2>
<table>
  <tr>
    <th>注文日</th>
    <td><%= @order.created_at %></td>
  </tr>
  <tr>
    <th>配送先</th>
    <td>〒<%= @order.address%></td>
  </tr>
  <tr>
    <th>支払方法</th>
    <td><%= @order.payment_method %></td>
  </tr>
  <tr>
    <th>ステータス</th>
    <td><%= @order.status%> </td>
  </tr>
</table>

<h2>請求情報</h2>
<table>
  <tr>
    <th>商品合計</th>
    <td><%= @order.total_payment - @order.shopping_cost %>円</td>
  </tr>
  <tr>
    <th>配送料</th>
    <td><%= @order.shopping_cost %>円</td>
  </tr>
  <tr>
    <th>ご請求額</th>
    <td><%= @order.total_payment %>円</td>
  </tr>
</table>

<h2>注文内容</h2>
<table>
  <thead>
    <tr>
      <th>商品</th>
      <th>単価(税込)</th>
      <th>個数</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_details.each do |detail| %>
      <tr>
        <td><%= detail.item.name %></td>
        <td><%= detail.price %>円</td>
        <td><%= detail.amount %></td>
        <td><%= detail.price * detail.amount %>円</td>
      </tr>
    <% end %>
  </tbody>
</table>