<span class="bg-light px-3 fs-5 fw-bold">注文履歴詳細</span>

<div class="d-flex gap-4 mt-5">

<div>
<p class="fw-bold mb-1">注文情報</p>
<table class="table table-bordered">
  <colgroup>
    <col>
    <col style="width: 350px;">
	</colgroup>
  <tbody>
  <tr>
    <td class="table-light">注文日</td>
    <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
  </tr>
  <tr>
    <td class="table-light">配送先</td>
    <td>〒<%= @order.address%></td>
  </tr>
  <tr>
    <td class="table-light">支払方法</td>
    <td><%= @order.payment_method %></td>
  </tr>
  <tr>
    <td class="table-light">ステータス</td>
    <td><%= @order.status%></td>
  </tr>
  </tbody>
</table>
</div>

<div>
<p class="fw-bold mb-1">請求情報</p>
<table class="table table-bordered">
  <colgroup>
    <col style="width: 200px;">
    <col style="width: 150px;">
    <col>
	</colgroup>
  <tbody>
  <tr>
    <td class="table-light">商品合計</td>
    <td><%= @order.total_payment - @order.shopping_cost %>円</td>
  </tr>
  <tr>
    <td class="table-light">配送料</td>
    <td><%= @order.shopping_cost %></td>
  </tr>
  <tr>
    <td class="table-light">ご請求額</td>
    <td><%= @order.total_payment %></td>
  </tr>
  </tbody>
</table>
</div>
</div>

<div class="mt-3" style="max-width: 600px;">
<p class="fw-bold mb-1">注文内容</p>
<table class="table table-bordered">
  <colgroup>
    <col style="width: 400px;">
    <col style="width: 150px;">
    <col style="width: 100px;">
    <col style="width: 100px;">
	</colgroup>
  <thead>
    <tr class="table-light">
      <th>商品</th>
      <th>単価(税込)</th>
      <th>個数</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_details.each do |detail| %>
      <tr>
        <td><%= detail.item.name %></td>
        <td><%= detail.price %>円</td>
        <td><%= detail.amount %></td>
        <td><%= detail.price * detail.amount %>円</td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>