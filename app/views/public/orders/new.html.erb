<h1>注文情報入力</h1>

<%= form_with model: @order, url: orders_confirm_path, method: :post do |f| %>

<h3>支払方法</h3>
<%= f.radio_button :payment_method, 0 %>
<%= f.label :payment_method_1, "クレジットカード" %>
<%= f.radio_button :payment_method, 1 %>
<%= f.label :payment_method_2, "銀行振込" %>

<h3>お届け先</h3>

<input type="radio" name="address_option" value="self" checked>
<label>ご自身の住所</label>
<p>〒<%= current_customer.postal_code %> <%= current_customer.address %></p>
<p><%= current_customer.name %></p>
<%= f.hidden_field :postal_code, value: current_customer.postal_code %>
<%= f.hidden_field :address, value: current_customer.address %>
<%= f.hidden_field :name, value: current_customer.name %>

<input type="radio" name="address_option" value="saved">
<label>登録済住所から選択</label>
<%= f.select :address_id, @addresses.map { |a| ["〒#{a.postal_code} #{a.address} #{a.name}", a.id] }, { include_blank: "選択してください" } %>

<input type="radio" name="address_option" value="new">
<label>新しいお届け先</label>
<div>
  <%= f.label :postal_code, "郵便番号(ハイフンなし)" %>
  <%= f.text_field :postal_code, placeholder: "0000000" %>
</div>
<div>
  <%= f.label :address, "住所" %>
  <%= f.text_field :address, placeholder: "東京都渋谷区代々木神園町0-0" %>
</div>
<div>
  <%= f.label :name, "宛名" %>
  <%= f.text_field :name, placeholder: "令和道子" %>
</div>

<%= f.submit "確認画面へ進む", class: "btn btn-primary" %>

<% end %>