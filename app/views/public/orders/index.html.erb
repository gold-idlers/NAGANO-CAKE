<span class="bg-light px-3 fs-5 fw-bold">注文履歴一覧</span>

<table class="table table-bordered mt-4">
  <colgroup>
    <col>
    <col style="width: 350px;">
    <col>
	</colgroup>
  <thead class="table-light">
    <tr>
      <th>注文日</th>
      <th>配送先</th>
      <th>注文商品</th>
      <th>支払金額</th>
      <th>ステータス</th>
      <th>注文詳細</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td>
          <%= order.created_at.strftime("%Y/%m/%d") %>
        </td>
        <td>
          <%= order.address %>
        </td>
        <td>
          <% order.order_details.each do |detail| %>
          <%= detail.item.name %><br>
          <% end %>
        </td>
        <td>
          <%= order.total_payment %>円
        </td>
        <td>
          <%= order.status %>
        </td>
        <td class="text-center" >
          <%= link_to "表示する", order_path(order), class: "btn btn-primary btn-sm me-2" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>